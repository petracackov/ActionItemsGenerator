        "read Q3 numbers": ["q3"],
        "don't skip the retro": ["retro"],
        "reset staging db": ["staging"]
      },
      "optional": {}
    },
    "Sample 2": {
      "required": {
        "check SSO with product": ["sso"],
        "pull export numbers (Ana)": ["50k", "export numbers", "how long exports", "export time", "export duration"],
        "walkthrough for new ops lead": ["walkthrough", "ops lead"]
      },
      "optional": {
        "address export speed before renewal": ["renewal", "march", "get ahead"],
        "pass on invite-without-admin request": ["admin", "invite"]
      }
    }
  }
}
